# Deny by default: unrelated local files cannot be added accidentally.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/LICENSE
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/PUBLISHING.md
!/RELEASE_CHECKS.md
!/SHA256SUMS.txt
!/app.py
!/start.bat
!/install.ps1
!/requirements*.txt
!/VideoWissen.exe
!/_internal/
!/_internal/**
!/video_assistant/
!/video_assistant/**
!/tests/
!/tests/**
!/tools/
!/tools/**
!/.github/
!/.github/**
!/third_party/
!/third_party/**
**/__pycache__/
**/*.py[cod]
# .pyd files are required native extensions in the portable Windows runtime.
!/_internal/**/*.pyd
!/_internal/*.pyd
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.pfx
**/*.p12
/models/
/exports/
/build/
/dist/
/.venv/
/.test-output/
/.app_state/
